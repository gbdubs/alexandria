{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_tl1_attempts",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [{"field": "started_at", "dir": "desc", "nulls": "last"}],
  "tiebreakSort": [{"field": "id", "dir": "asc"}],
  "defaultSelect": [{"field": "started_at", "width": 110}, {"field": "flavor", "width": 170}, {"field": "configuration", "width": 150}, {"field": "disposition", "width": 95}, {"field": "outcome", "width": 150}, {"field": "cost_usd", "width": 95}, {"field": "duration_ms", "width": 90}, {"field": "total_tokens", "width": 110}, {"field": "error_signature", "width": 240}, {"field": "title", "width": 260}],
  "fields": [
    {"name": "id", "label": "Row ID", "type": "text", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "id", "synthetic": true}}},
    {"name": "started_at", "label": "Started", "type": "datetime", "group": "Time", "render": "datetime_rel", "bindings": {"postgres": {"expr": "started_at", "synthetic": true}}},
    {"name": "task_created_at", "label": "Task created", "type": "datetime", "group": "Time", "render": "datetime_rel", "select": {"default": false}, "bindings": {"postgres": {"expr": "task_created_at", "synthetic": true}}},
    {"name": "day", "label": "Day", "type": "text", "group": "Time", "select": {"default": false}, "bindings": {"postgres": {"expr": "day", "synthetic": true}}},
    {"name": "project", "label": "Project", "type": "text", "group": "Context", "aliases": ["installation"], "bindings": {"postgres": {"expr": "project", "synthetic": true}}},
    {"name": "mac", "label": "Mac", "type": "text", "group": "Context", "aliases": ["host"], "select": {"default": false}, "bindings": {"postgres": {"expr": "mac", "synthetic": true}}},
    {"name": "installation_id", "label": "Installation ID", "type": "text", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "installation_id", "synthetic": true}}},
    {"name": "flavor", "label": "Flavor", "type": "text", "group": "Workflow", "aliases": ["shape"], "bindings": {"postgres": {"expr": "flavor", "synthetic": true}}},
    {"name": "execution_class", "label": "Execution class", "type": "enum", "group": "Workflow", "select": {"default": false}, "filter": {"values": {"source": "static", "options": [{"value": "llm", "label": "LLM"}, {"value": "procedural", "label": "Procedural"}, {"value": "human", "label": "Human"}]}}, "bindings": {"postgres": {"expr": "execution_class", "synthetic": true}}},
    {"name": "shape_version", "label": "Flavor version", "type": "text", "group": "Workflow", "select": {"default": false}, "bindings": {"postgres": {"expr": "shape_version", "synthetic": true}}},
    {"name": "configuration", "label": "Agent configuration", "type": "text", "group": "Agent", "aliases": ["config"], "bindings": {"postgres": {"expr": "configuration", "synthetic": true}}},
    {"name": "executor", "label": "Executor", "type": "enum", "group": "Agent", "select": {"default": false}, "filter": {"values": {"source": "static", "options": [{"value": "claude", "label": "Claude"}, {"value": "codex", "label": "Codex"}]}}, "bindings": {"postgres": {"expr": "executor", "synthetic": true}}},
    {"name": "model", "label": "Model", "type": "text", "group": "Agent", "select": {"default": false}, "bindings": {"postgres": {"expr": "model", "synthetic": true}}},
    {"name": "effort", "label": "Effort", "type": "text", "group": "Agent", "select": {"default": false}, "bindings": {"postgres": {"expr": "effort", "synthetic": true}}},
    {"name": "disposition", "label": "Result", "type": "enum", "group": "Outcome", "filter": {"values": {"source": "static", "options": [{"value": "advanced", "label": "Advanced"}, {"value": "escalated", "label": "Escalated to human"}, {"value": "error", "label": "Error"}, {"value": "retried", "label": "Retried"}, {"value": "open", "label": "Open"}]}}, "bindings": {"postgres": {"expr": "disposition", "synthetic": true}}},
    {"name": "outcome", "label": "Outcome", "type": "text", "group": "Outcome", "bindings": {"postgres": {"expr": "outcome", "synthetic": true}}},
    {"name": "error_class", "label": "Error class", "type": "text", "group": "Errors", "select": {"default": false}, "bindings": {"postgres": {"expr": "error_class", "synthetic": true}}},
    {"name": "error_attribution", "label": "Error attribution", "type": "enum", "group": "Errors", "select": {"default": false}, "filter": {"values": {"source": "static", "options": [{"value": "infrastructure", "label": "Infrastructure"}, {"value": "configuration", "label": "Configuration"}, {"value": "output_contract", "label": "Output contract"}, {"value": "script", "label": "Script"}, {"value": "provider", "label": "Provider"}, {"value": "agent", "label": "Agent"}]}}, "bindings": {"postgres": {"expr": "error_attribution", "synthetic": true}}},
    {"name": "error_signature", "label": "Error", "type": "text", "group": "Errors", "render": "truncate", "bindings": {"postgres": {"expr": "error_signature", "synthetic": true}}},
    {"name": "cost_usd", "label": "Cost (API $)", "type": "number", "group": "Cost", "render": "usd", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "cost_usd", "synthetic": true}}},
    {"name": "cost_source", "label": "Cost source", "type": "enum", "group": "Cost", "select": {"default": false}, "filter": {"values": {"source": "static", "options": [{"value": "tokens", "label": "Priced from tokens"}, {"value": "tl1-reported", "label": "Reported by TL1"}]}}, "bindings": {"postgres": {"expr": "cost_source", "synthetic": true}}},
    {"name": "duration_ms", "label": "Duration", "type": "number", "group": "Performance", "render": "duration_ms", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "duration_ms", "synthetic": true}}},
    {"name": "total_tokens", "label": "Total tokens", "type": "number", "group": "Tokens", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "total_tokens", "synthetic": true}}},
    {"name": "output_tokens", "label": "Output tokens", "type": "number", "group": "Tokens", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "output_tokens", "synthetic": true}}},
    {"name": "reasoning_tokens", "label": "Reasoning tokens", "type": "number", "group": "Tokens", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "reasoning_tokens", "synthetic": true}}},
    {"name": "cache_read_share", "label": "Cache-read share %", "type": "number", "group": "Tokens", "render": "number", "select": {"default": false, "align": "right"}, "aggregate": {"measure": false}, "bindings": {"postgres": {"expr": "cache_read_share", "synthetic": true}}},
    {"name": "lines_changed", "label": "Lines changed", "type": "number", "group": "Changes", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "lines_changed", "synthetic": true}}},
    {"name": "files_changed", "label": "Files changed", "type": "number", "group": "Changes", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "files_changed", "synthetic": true}}},
    {"name": "peak_rss_mb", "label": "Peak memory (MB)", "type": "number", "group": "Performance", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "peak_rss_mb", "synthetic": true}}},
    {"name": "revisit", "label": "Repeat visit", "type": "bool", "group": "Workflow", "select": {"default": false}, "bindings": {"postgres": {"expr": "revisit", "synthetic": true}}},
    {"name": "has_transcript", "label": "Has transcript", "type": "bool", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "has_transcript", "synthetic": true}}},
    {"name": "attempt_count", "label": "Runs", "type": "number", "group": "Counts", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "attempt_count", "synthetic": true}}},
    {"name": "error_count", "label": "Errors", "type": "number", "group": "Counts", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "error_count", "synthetic": true}}},
    {"name": "advanced_count", "label": "Advanced", "type": "number", "group": "Counts", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "advanced_count", "synthetic": true}}},
    {"name": "escalated_count", "label": "Escalated", "type": "number", "group": "Counts", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "escalated_count", "synthetic": true}}},
    {"name": "title", "label": "Task", "type": "text", "group": "Context", "render": "work_title", "bindings": {"postgres": {"expr": "title", "synthetic": true}}},
    {"name": "candidate_id", "label": "Candidate ID", "type": "text", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "candidate_id", "synthetic": true}}},
    {"name": "task_id", "label": "Task ID", "type": "text", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "task_id", "synthetic": true}}},
    {"name": "attempt_id", "label": "Attempt ID", "type": "text", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "attempt_id", "synthetic": true}}},
    {"name": "workspace_id", "label": "Workspace ID", "type": "text", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "workspace_id", "synthetic": true}}}
  ]
}
