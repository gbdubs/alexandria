{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_tool_calls",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [
    {
      "field": "started_at",
      "dir": "desc",
      "nulls": "last"
    }
  ],
  "tiebreakSort": [
    {
      "field": "id",
      "dir": "asc"
    }
  ],
  "defaultSelect": [
    {
      "field": "started_at",
      "width": 150
    },
    {
      "field": "tool_name",
      "width": 120
    },
    {
      "field": "command",
      "width": 300
    },
    {
      "field": "status",
      "width": 80
    },
    {
      "field": "error_type",
      "width": 120
    },
    {
      "field": "duration_ms",
      "width": 100
    },
    {
      "field": "result_tokens",
      "width": 110
    },
    {
      "field": "carried_tokens",
      "width": 120
    },
    {
      "field": "tool_cost_usd",
      "width": 95
    },
    {
      "field": "title",
      "width": 240
    }
  ],
