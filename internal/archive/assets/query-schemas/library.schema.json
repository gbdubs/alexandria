{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_library",
  "version": 2,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [{ "field": "activity_at", "dir": "desc", "nulls": "last" }],
  "tiebreakSort": [{ "field": "id", "dir": "asc" }],
  "defaultSelect": [
    { "field": "activity_at", "width": 130 },
    { "field": "title", "width": 300 },
    { "field": "repository_name", "width": 150 },
    { "field": "models", "width": 200 },
    { "field": "token_count", "width": 100 },
    { "field": "cost_usd", "width": 100 },
    { "field": "subagent_count", "width": 90 },
    { "field": "pr_numbers", "width": 300 }
  ],
  "fields": [
    { "name": "id", "label": "ID", "type": "text", "select": { "default": false }, "bindings": { "postgres": { "expr": "w.id" } } },
    { "name": "title", "label": "Work", "type": "text", "group": "Work", "render": "work_title", "bindings": { "postgres": { "expr": "w.title" } } },
    { "name": "repository_name", "label": "Repository", "type": "text", "group": "Context", "aliases": ["repo"], "bindings": { "postgres": { "expr": "repository_name" } } },
    { "name": "source_kind", "label": "Source", "type": "enum", "group": "Context", "filter": { "values": { "source": "static", "options": [{ "value": "tl1", "label": "TL1" }, { "value": "tl1-export", "label": "TL1 export" }, { "value": "conductor", "label": "Conductor" }, { "value": "codex", "label": "Codex" }, { "value": "claude", "label": "Claude" }, { "value": "chatgpt", "label": "ChatGPT" }, { "value": "canonical", "label": "Canonical" }] } }, "bindings": { "postgres": { "expr": "w.source_kind" } } },
    { "name": "activity_at", "label": "Last activity", "type": "datetime", "group": "Time", "render": "datetime_rel", "bindings": { "postgres": { "expr": "w.activity_at" } } },
    { "name": "purpose", "label": "Purpose", "type": "text", "group": "Work", "render": "truncate", "bindings": { "postgres": { "expr": "w.purpose" } } },
    { "name": "outcome", "label": "Outcome", "type": "text", "group": "Work", "render": "truncate", "bindings": { "postgres": { "expr": "w.outcome" } } },
    { "name": "branch", "label": "Branch", "type": "text", "group": "Context", "render": "truncate", "bindings": { "postgres": { "expr": "w.branch" } } },
    { "name": "owner", "label": "Owner", "type": "text", "group": "Context", "bindings": { "postgres": { "expr": "w.owner" } } },
    { "name": "flavor", "label": "TL1 flavor", "type": "text", "group": "Context", "bindings": { "postgres": { "expr": "w.flavor" } } },
    { "name": "version", "label": "Version", "type": "text", "group": "Context", "bindings": { "postgres": { "expr": "w.version" } } },
    { "name": "lifecycle", "label": "Lifecycle", "type": "enum", "group": "Context", "bindings": { "postgres": { "expr": "w.lifecycle" } } },
    { "name": "preservation_completeness", "label": "Preservation", "type": "enum", "group": "Archive", "bindings": { "postgres": { "expr": "w.preservation_completeness" } } },
    { "name": "conversation_count", "label": "Conversations", "type": "number", "group": "Counts", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "conversation_count", "synthetic": true } } },
    { "name": "turn_count", "label": "Turns", "type": "number", "group": "Counts", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "turn_count", "synthetic": true } } },
    { "name": "token_count", "label": "Tokens", "type": "number", "group": "Usage", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "token_count", "synthetic": true } } },
    { "name": "cost_usd", "label": "Cost (API $)", "type": "number", "group": "Cost", "render": "usd", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "cost_usd", "synthetic": true } } },
    { "name": "cost_today_usd", "label": "Cost at today's prices", "type": "number", "group": "Cost", "render": "usd", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "cost_today_usd", "synthetic": true } } },
    { "name": "price_status", "label": "Price status", "type": "enum", "group": "Cost", "select": { "default": false }, "filter": { "values": { "source": "static", "options": ["priced", "assumed", "partial", "unpriced"] } }, "bindings": { "postgres": { "expr": "price_status", "synthetic": true } } },
    { "name": "tool_use_count", "label": "Tool uses", "type": "number", "group": "Usage", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "tool_use_count", "synthetic": true } } },
    { "name": "tool_error_count", "label": "Tool errors", "type": "number", "group": "Usage", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "tool_error_count", "synthetic": true } } },
    { "name": "compaction_count", "label": "Compactions", "type": "number", "group": "Usage", "aliases": ["compactions", "compacts"], "render": "number", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "compaction_count", "synthetic": true } } },
    { "name": "subagent_count", "label": "Sub-agents", "type": "number", "group": "Counts", "aliases": ["subagents"], "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "subagent_count", "synthetic": true } } },
    { "name": "subagent_depth", "label": "Sub-agent depth", "type": "number", "group": "Counts", "aliases": ["agent_depth", "nesting"], "render": "number", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "subagent_depth", "synthetic": true } } },
    { "name": "pr_count", "label": "PRs", "type": "number", "group": "Counts", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "pr_count", "synthetic": true } } },
    { "name": "branch_count", "label": "Branches", "type": "number", "group": "Counts", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "branch_count", "synthetic": true } } },
    { "name": "file_edit_count", "label": "File edits", "type": "number", "group": "Counts", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "file_edit_count", "synthetic": true } } },
    { "name": "changed_file_count", "label": "Changed files", "type": "number", "group": "Counts", "render": "number", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "changed_file_count", "synthetic": true } } },
    { "name": "pr_numbers", "label": "GitHub PRs", "type": "text", "group": "Links", "aliases": ["PR"], "render": "pull_requests", "bindings": { "postgres": { "expr": "pr_numbers", "synthetic": true } } },
    { "name": "main_merge_title", "label": "origin/main", "type": "text", "group": "Links", "render": "main_integration", "bindings": { "postgres": { "expr": "w.main_merge_title" } } },
    { "name": "providers", "label": "Providers", "type": "text", "group": "Context", "select": { "default": false }, "bindings": { "postgres": { "expr": "providers", "synthetic": true } } },
    { "name": "models", "label": "Models", "type": "text", "group": "Context", "bindings": { "postgres": { "expr": "models", "synthetic": true } } },
    { "name": "changed_files", "label": "Changed file path", "type": "text", "group": "Changes", "select": { "enabled": false }, "aliases": ["file", "path"], "bindings": { "postgres": { "expr": "changed_files", "synthetic": true } } },
    { "name": "error_types", "label": "Error type", "type": "text", "group": "Metrics", "select": { "enabled": false }, "bindings": { "postgres": { "expr": "error_types", "synthetic": true } } },
    { "name": "location", "label": "Location", "type": "text", "group": "Archive", "render": "truncate", "bindings": { "postgres": { "expr": "w.location" } } }
  ]
}
