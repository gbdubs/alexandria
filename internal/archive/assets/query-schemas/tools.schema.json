{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "alexandria_tools",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [
    {
      "field": "day",
      "dir": "desc",
      "nulls": "last"
    },
    {
      "field": "call_count",
      "dir": "desc"
    }
  ],
  "tiebreakSort": [
    {
      "field": "id",
      "dir": "asc"
    }
  ],
  "defaultSelect": [
    {
      "field": "day",
      "width": 105
    },
    {
      "field": "tool_name",
      "width": 140
    },
    {
      "field": "command_name",
      "width": 150
    },
    {
      "field": "provider",
      "width": 85
    },
    {
      "field": "model_family",
      "width": 120
    },
    {
      "field": "call_count",
      "width": 85
    },
    {
      "field": "error_count",
      "width": 80
    },
    {
      "field": "error_rate",
      "width": 85
    },
    {
      "field": "avg_duration_ms",
      "width": 110
    },
    {
      "field": "result_tokens",
      "width": 115
