{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_usage",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [{ "field": "day", "dir": "desc", "nulls": "last" }, { "field": "total_tokens", "dir": "desc" }],
  "tiebreakSort": [{ "field": "id", "dir": "asc" }],
  "defaultSelect": [
    { "field": "day", "width": 105 },
    { "field": "repository_name", "width": 150 },
    { "field": "provider", "width": 90 },
    { "field": "model_family", "width": 130 },
    { "field": "session_kind", "width": 85 },
    { "field": "total_tokens", "width": 115 },
    { "field": "cost_usd", "width": 105 },
    { "field": "uncached_input_tokens", "width": 115 },
    { "field": "cache_read_input_tokens", "width": 130 },
    { "field": "cache_creation_input_tokens", "width": 110 },
    { "field": "output_tokens", "width": 100 },
    { "field": "title", "width": 280 }
  ],
  "fields": [
    { "name": "id", "label": "Row ID", "type": "text", "select": { "default": false }, "bindings": { "postgres": { "expr": "id", "synthetic": true } } },
    { "name": "day", "label": "Day", "type": "text", "group": "Time", "aliases": ["date"], "bindings": { "postgres": { "expr": "day", "synthetic": true } } },
    { "name": "week", "label": "Week (Mon)", "type": "text", "group": "Time", "bindings": { "postgres": { "expr": "week", "synthetic": true } } },
    { "name": "month", "label": "Month", "type": "text", "group": "Time", "bindings": { "postgres": { "expr": "month", "synthetic": true } } },
    { "name": "first_usage_at", "label": "First usage", "type": "datetime", "group": "Time", "render": "datetime_rel", "select": { "default": false }, "bindings": { "postgres": { "expr": "first_usage_at", "synthetic": true } } },
    { "name": "last_usage_at", "label": "Last usage", "type": "datetime", "group": "Time", "render": "datetime_rel", "select": { "default": false }, "bindings": { "postgres": { "expr": "last_usage_at", "synthetic": true } } },
    { "name": "repository_name", "label": "Repository", "type": "text", "group": "Context", "aliases": ["repo"], "bindings": { "postgres": { "expr": "r.display_name" } } },
    { "name": "provider", "label": "Provider", "type": "enum", "group": "Model", "aliases": ["service"], "filter": { "values": { "source": "static", "options": [{ "value": "claude", "label": "Claude" }, { "value": "codex", "label": "Codex" }, { "value": "tl1", "label": "TL1" }, { "value": "chatgpt", "label": "ChatGPT" }, { "value": "canonical", "label": "Canonical" }] } }, "bindings": { "postgres": { "expr": "a.provider" } } },
    { "name": "model_family", "label": "Model", "type": "text", "group": "Model", "bindings": { "postgres": { "expr": "model_family", "synthetic": true } } },
    { "name": "model", "label": "Reported model", "type": "text", "group": "Model", "select": { "default": false }, "bindings": { "postgres": { "expr": "model", "synthetic": true } } },
    { "name": "source_kind", "label": "Source", "type": "enum", "group": "Context", "filter": { "values": { "source": "static", "options": [{ "value": "tl1", "label": "TL1" }, { "value": "tl1-export", "label": "TL1 export" }, { "value": "conductor", "label": "Conductor" }, { "value": "codex", "label": "Codex" }, { "value": "claude", "label": "Claude" }, { "value": "chatgpt", "label": "ChatGPT" }, { "value": "canonical", "label": "Canonical" }] } }, "bindings": { "postgres": { "expr": "w.source_kind" } } },
    { "name": "session_kind", "label": "Agent", "type": "enum", "group": "Context", "filter": { "values": { "source": "static", "options": ["root", "subagent"] } }, "bindings": { "postgres": { "expr": "a.kind" } } },
    { "name": "depth", "label": "Agent depth", "type": "number", "group": "Context", "render": "number", "select": { "default": false, "align": "right" }, "aggregate": { "groupable": true }, "bindings": { "postgres": { "expr": "a.depth" } } },
    { "name": "title", "label": "Work", "type": "text", "group": "Context", "render": "work_title", "bindings": { "postgres": { "expr": "w.title" } } },
    { "name": "total_tokens", "label": "Total tokens", "type": "number", "group": "Tokens", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "u.total_tokens" } } },
    { "name": "input_tokens", "label": "Input (all)", "type": "number", "group": "Tokens", "render": "number", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "u.input_tokens" } } },
    { "name": "uncached_input_tokens", "label": "Uncached input", "type": "number", "group": "Tokens", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "u.uncached_input_tokens" } } },
    { "name": "cache_read_input_tokens", "label": "Cached input (reads)", "type": "number", "group": "Tokens", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "u.cache_read_input_tokens" } } },
    { "name": "cache_creation_input_tokens", "label": "Cache writes", "type": "number", "group": "Tokens", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "u.cache_creation_input_tokens" } } },
    { "name": "cache_creation_5m_input_tokens", "label": "Cache writes (5m)", "type": "number", "group": "Tokens", "render": "number", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "u.cache_creation_5m_input_tokens" } } },
    { "name": "cache_creation_1h_input_tokens", "label": "Cache writes (1h)", "type": "number", "group": "Tokens", "render": "number", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "u.cache_creation_1h_input_tokens" } } },
    { "name": "output_tokens", "label": "Output", "type": "number", "group": "Tokens", "render": "number", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "u.output_tokens" } } },
    { "name": "reasoning_output_tokens", "label": "Reasoning output", "type": "number", "group": "Tokens", "render": "number", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "u.reasoning_output_tokens" } } },
    { "name": "unclassified_tokens", "label": "Unclassified", "type": "number", "group": "Tokens", "render": "number", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "u.unclassified_tokens" } } },
    { "name": "cost_usd", "label": "Cost (API $)", "type": "number", "group": "Cost", "render": "usd", "select": { "align": "right" }, "bindings": { "postgres": { "expr": "cost_usd", "synthetic": true } } },
    { "name": "cost_today_usd", "label": "Cost at today's prices", "type": "number", "group": "Cost", "render": "usd", "select": { "default": false, "align": "right" }, "bindings": { "postgres": { "expr": "cost_today_usd", "synthetic": true } } },
    { "name": "price_status", "label": "Price status", "type": "enum", "group": "Cost", "select": { "default": false }, "filter": { "values": { "source": "static", "options": ["priced", "assumed", "partial", "unpriced"] } }, "bindings": { "postgres": { "expr": "price_status", "synthetic": true } } },
    { "name": "priced_model", "label": "Priced as", "type": "text", "group": "Cost", "select": { "default": false }, "bindings": { "postgres": { "expr": "priced_model", "synthetic": true } } },
    { "name": "cache_read_share", "label": "Cache-read share %", "type": "number", "group": "Tokens", "render": "number", "select": { "default": false, "align": "right" }, "aggregate": { "measure": false }, "bindings": { "postgres": { "expr": "cache_read_share", "synthetic": true } } },
    { "name": "attribution", "label": "Time placement", "type": "enum", "group": "Evidence", "select": { "default": false }, "filter": { "values": { "source": "static", "options": [{ "value": "request", "label": "Request time" }, { "value": "session-start", "label": "Session start" }] } }, "bindings": { "postgres": { "expr": "u.attribution" } } },
    { "name": "workspace_id", "label": "Workspace ID", "type": "text", "group": "Evidence", "select": { "default": false }, "bindings": { "postgres": { "expr": "w.id" } } },
    { "name": "conversation_id", "label": "Conversation ID", "type": "text", "group": "Evidence", "select": { "default": false }, "bindings": { "postgres": { "expr": "a.conversation_id" } } },
    { "name": "agent_session_id", "label": "Agent session ID", "type": "text", "group": "Evidence", "select": { "default": false }, "bindings": { "postgres": { "expr": "a.id" } } }
  ]
}
